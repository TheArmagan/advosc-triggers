# This repo is a Unity package, not a Unity project. Keep .meta files tracked: Unity uses their
# guids to resolve references, and the release build fails without them.

# Release and Pages output
/dist/
/_site/
node_modules/

# Unity folders, if the repo is ever opened as a project. Test avatars stay out of git.
/[Aa]ssets/
/[Ll]ibrary/
/[Ll]ogs/
/[Oo]bj/
/[Pp]roject[Ss]ettings/
/[Tt]emp/
/[Uu]ser[Ss]ettings/

# Generated by IDEs
.idea/
.vs/
.vscode/
*.csproj
*.sln
*.suo
*.user
*.userprefs

# OS files
.DS_Store
Thumbs.db
desktop.ini
